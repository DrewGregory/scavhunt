# syntax=docker/dockerfile:1

FROM node:22-slim

WORKDIR /usr/src/app

# openssl is needed by Prisma engines; ca-certificates for corepack downloads.
RUN apt-get update \
  && apt-get install -y --no-install-recommends openssl ca-certificates \
  && rm -rf /var/lib/apt/lists/* \
  && corepack enable \
  && corepack prepare pnpm@10.15.0 --activate

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY prisma ./prisma
RUN --mount=type=cache,id=scavhunt-pnpm-store,target=/root/.local/share/pnpm/store \
  pnpm install --frozen-lockfile

# Copy the rest of the source. Host bind mounts in docker-compose override these
# paths so edits are picked up live.
COPY . .

ENV NODE_ENV=development
EXPOSE 80
CMD ["pnpm", "dev"]
