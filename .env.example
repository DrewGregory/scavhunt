# Postgres (local docker-compose maps host 5434 -> container 5432)
DATABASE_URL="postgresql://scavhunt:scavhunt@localhost:5434/scavhunt?schema=public"

# HMAC secret for signed session cookies (use a long random string in production)
SESSION_SECRET="change-me-to-a-long-random-string"

# Bird Verify API (https://docs.bird.com/api/verify-api)
BIRD_API_KEY=""
BIRD_API_HOST="https://us1.platform.bird.com"

# Optional: mock Bird OTP in local/dev (code always "000000")
BIRD_MOCK="true"
NEXT_PUBLIC_BIRD_MOCK="true"

# Comma-separated emails that become admins on signup/login
ADMIN_EMAILS="example@example.com"

# Public site origin used for CSRF Origin checks
APP_ORIGIN="http://localhost"

# Hunt timing / branding
START_TIME_ISO_STRING="2026-10-01T16:00:00.000Z"
END_TIME_ISO_STRING="2026-10-01T01:00:00.000Z"
SCAVENGER_HUNT_NAME="Scavenger Hunt"
SHOW_HOW_TO_PLAY="true"

# DigitalOcean Spaces / S3-compatible uploads
SPACES_BUCKET_NAME=
SPACES_ENDPOINT=
SPACES_KEY=
SPACES_REGION=
SPACES_SECRET=
