generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id         String    @id @default(cuid())
  email      String    @unique
  phoneE164  String    @unique
  name       String
  isAdmin    Boolean   @default(false)
  isActive   Boolean   @default(true)
  teamId     String?
  createdAt  DateTime  @default(now())
  lastSeenAt DateTime?
  updatedAt  DateTime  @updatedAt

  /// playing | browsing — set by player survey
  intent              String?
  teamPreferences     String?
  competitiveness     String?
  /// Full-day availability notes from player survey
  timeCommitment      String?
  surveyCompletedAt   DateTime?

  team         Team?         @relation(fields: [teamId], references: [id], onDelete: SetNull)
  submissions  Submission[]
  favorites    Favorite[]
  chatMessages ChatMessage[]
  votes        Vote[]
  deposits     NeighborhoodDeposit[]

  @@index([teamId])
}

/// Singleton hunt window (id = "default"). Separate from tournament round deadlines.
model HuntSettings {
  id        String   @id @default("default")
  startsAt  DateTime
  endsAt    DateTime
  /// Master switch for the whole territory feature. Off = players see no trace of it.
  territoryEnabled Boolean @default(false)
  updatedAt DateTime @updatedAt
}

/// When voting for a given tournament round closes (lazy auto-advance).
model TournamentRoundSchedule {
  id        String   @id @default(cuid())
  round     Int      @unique
  endsAt    DateTime
  updatedAt DateTime @updatedAt
}

model Team {
  id        String   @id @default(cuid())
  name      String
  emoji     String
  /// Hex color used for territory map fill / labels.
  color     String   @default("#3182CE")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users        User[]
  submissions  Submission[]
  locations    Location[]
  chatMessages ChatMessage[]
  deposits     NeighborhoodDeposit[]
}

model Challenge {
  id         String   @id @default(cuid())
  title      String
  prompt     String
  lat        Float
  lng        Float
  pts        Int
  numWinners Int
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  submissions Submission[]
}

model Submission {
  id          String   @id @default(cuid())
  teamId      String
  userId      String
  challengeId String
  accepted    Boolean  @default(false)
  rejected    Boolean  @default(false)
  mediaURL    String?
  note        String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  team      Team      @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  challenge Challenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  favorites Favorite[]

  @@index([teamId])
  @@index([challengeId])
  @@index([userId])
  @@index([createdAt])
}

model Favorite {
  id           String   @id @default(cuid())
  submissionId String
  userId       String
  createdAt    DateTime @default(now())

  submission Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([submissionId, userId])
  @@index([userId])
}

model Location {
  id        String   @id @default(cuid())
  teamId    String
  lat       Float
  lng       Float
  createdAt DateTime @default(now())

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@index([teamId, createdAt])
}

model ChatMessage {
  id        String   @id @default(cuid())
  teamId    String
  userId    String
  message   String
  isAdmin   Boolean  @default(false)
  createdAt DateTime @default(now())

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([teamId, createdAt])
  @@index([createdAt])
}

model Neighborhood {
  id        String   @id @default(cuid())
  name      String   @unique
  /// Optional display emoji; falls back to a hash of the name when null.
  emoji     String?
  /// GeoJSON Polygon | MultiPolygon, WGS84 [lng, lat]. Null = no boundary yet.
  /// Derived from MapTopology arcs when topology is imported — do not freehand-edit.
  boundary  Json?
  /// Participates in the territory map (tournament-only entries stay false).
  onMap     Boolean  @default(false)
  /// True only for Treasure Island (Yerba Buena). Mainland zones must be a single ring.
  isIsland  Boolean  @default(false)
  centerLat Float?
  centerLng Float?
  createdAt DateTime @default(now())

  matchupsAsA Matchup[] @relation("MatchupSlotA")
  matchupsAsB Matchup[] @relation("MatchupSlotB")
  wins        Matchup[] @relation("MatchupWinner")
  votes       Vote[]
  deposits    NeighborhoodDeposit[]
}

/// Singleton shared-edge topology for gap-free SF territory boundaries.
model MapTopology {
  id         String   @id @default("default")
  /// Quantization scale/translate from topojson (optional).
  transform  Json?
  /// Absolute arc coordinates: arcIndex -> [[lng, lat], ...]
  arcs       Json
  /// neighborhoodId -> rings of signed arc indices (topojson-style)
  objects    Json
  /// Arc indices that form shoreline / city outline — not editable.
  lockedArcs Json
  version    Int      @default(1)
  updatedAt  DateTime @updatedAt
}

model NeighborhoodDeposit {
  id             String   @id @default(cuid())
  teamId         String
  neighborhoodId String
  userId         String
  points         Int
  lat            Float
  lng            Float
  accuracy       Float?
  /// Soft-delete / admin void. Voided deposits do not count toward standings or score.
  voidedAt       DateTime?
  createdAt      DateTime @default(now())

  team         Team         @relation(fields: [teamId], references: [id], onDelete: Cascade)
  neighborhood Neighborhood @relation(fields: [neighborhoodId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([neighborhoodId])
  @@index([teamId])
  @@index([userId])
  @@index([createdAt])
}

model Matchup {
  id       String  @id @default(cuid())
  round    Int
  slotAId  String
  slotBId  String
  winnerId String?
  isOpen   Boolean @default(true)

  slotA  Neighborhood  @relation("MatchupSlotA", fields: [slotAId], references: [id])
  slotB  Neighborhood  @relation("MatchupSlotB", fields: [slotBId], references: [id])
  winner Neighborhood? @relation("MatchupWinner", fields: [winnerId], references: [id])
  votes  Vote[]

  @@index([round])
}

model Vote {
  id             String   @id @default(cuid())
  userId         String
  matchupId      String
  neighborhoodId String
  createdAt      DateTime @default(now())

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  matchup      Matchup      @relation(fields: [matchupId], references: [id], onDelete: Cascade)
  neighborhood Neighborhood @relation(fields: [neighborhoodId], references: [id], onDelete: Cascade)

  @@unique([userId, matchupId])
  @@index([matchupId])
}
