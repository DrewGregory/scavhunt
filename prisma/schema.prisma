generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id         String    @id @default(cuid())
  email      String    @unique
  phoneE164  String    @unique
  name       String
  isAdmin    Boolean   @default(false)
  isActive   Boolean   @default(true)
  teamId     String?
  createdAt  DateTime  @default(now())
  lastSeenAt DateTime?
  updatedAt  DateTime  @updatedAt
  /// Soft-delete; null = live.
  deletedAt  DateTime?

  /// playing | browsing — set by player survey
  intent              String?
  teamPreferences     String?
  competitiveness     String?
  /// Full-day availability notes from player survey
  timeCommitment      String?
  surveyCompletedAt   DateTime?

  team         Team?         @relation(fields: [teamId], references: [id], onDelete: SetNull)
  submissions  Submission[]
  favorites    Favorite[]
  submissionComments SubmissionComment[]
  deposits     NeighborhoodDeposit[]
  announcementDismissals AnnouncementDismissal[]

  @@index([teamId])
  @@index([deletedAt])
}

/// Singleton hunt window (id = "default").
model HuntSettings {
  id        String   @id @default("default")
  startsAt  DateTime
  endsAt    DateTime
  /// Master switch for the whole territory feature. Off = players see no trace of it.
  territoryEnabled Boolean @default(false)
  /// Partial UploadConfig overrides (lib/upload/config.ts); null = code defaults.
  uploadConfig Json?
  updatedAt DateTime @updatedAt
}

model Team {
  id        String   @id @default(cuid())
  name      String
  emoji     String
  /// Hex color used for territory map fill / labels.
  color     String   @default("#3182CE")
  /// Admin-granted (or clawed-back) points; included in spendable score.
  bonusPoints Int    @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  /// Soft-delete; null = live.
  deletedAt DateTime?

  users        User[]
  submissions  Submission[]
  locations    Location[]
  deposits     NeighborhoodDeposit[]
  challengeFavorites ChallengeFavorite[]

  @@index([deletedAt])
}

model Challenge {
  id         String   @id @default(cuid())
  title      String
  prompt     String
  /// Optional leading emoji shown before the title in lists/maps.
  emoji      String?
  /// Null = unplaced draft; map falls back to SF center for display.
  lat        Float?
  lng        Float?
  pts        Int
  numWinners Int
  /// Player visibility. false = draft/off (admin canvas only).
  enabled    Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  /// Soft-delete; null = live.
  deletedAt  DateTime?

  submissions Submission[]
  teamFavorites ChallengeFavorite[]

  @@index([deletedAt])
  @@index([enabled])
}

model Submission {
  id          String   @id @default(cuid())
  teamId      String
  userId      String
  challengeId String
  accepted    Boolean  @default(false)
  rejected    Boolean  @default(false)
  mediaURL    String?
  posterURL   String?
  durationSec Float?
  width       Int?
  height      Int?
  /// Bytes actually uploaded (after client compression, if any).
  sizeBytes         Int?
  originalSizeBytes Int?
  compressed        Boolean?
  note        String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  /// Soft-delete; null = live. Separate from accepted/rejected moderation.
  deletedAt   DateTime?

  team      Team      @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  challenge Challenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  favorites Favorite[]
  comments  SubmissionComment[]

  @@index([teamId])
  @@index([challengeId])
  @@index([userId])
  @@index([createdAt])
  @@index([deletedAt])
}

model Favorite {
  id           String   @id @default(cuid())
  submissionId String
  userId       String
  createdAt    DateTime @default(now())

  submission Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([submissionId, userId])
  @@index([userId])
}

model SubmissionComment {
  id           String   @id @default(cuid())
  submissionId String
  userId       String
  body         String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  /// Soft-delete; null = live.
  deletedAt    DateTime?

  submission Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([submissionId, createdAt])
  @@index([userId])
  @@index([deletedAt])
}

/// Shared team pin/favorite for a challenge (any teammate can toggle).
model ChallengeFavorite {
  id             String   @id @default(cuid())
  challengeId    String
  teamId         String
  createdByUserId String?
  createdAt      DateTime @default(now())

  challenge Challenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  team      Team      @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([challengeId, teamId])
  @@index([teamId])
  @@index([challengeId])
}

model Location {
  id        String   @id @default(cuid())
  teamId    String
  lat       Float
  lng       Float
  createdAt DateTime @default(now())

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@index([teamId, createdAt])
}

model Neighborhood {
  id        String   @id @default(cuid())
  /// Display name (duplicates allowed — soft-deleted absorbs must not block renames).
  name      String
  /// Optional display emoji; falls back to a hash of the name when null.
  emoji     String?
  /// GeoJSON Polygon | MultiPolygon, WGS84 [lng, lat]. Null = no boundary yet.
  /// Derived from MapTopology arcs when topology is imported — do not freehand-edit.
  boundary  Json?
  /// Participates in the territory map.
  onMap     Boolean  @default(false)
  /// True only for Treasure Island (Yerba Buena). Mainland zones must be a single ring.
  isIsland  Boolean  @default(false)
  centerLat Float?
  centerLng Float?
  createdAt DateTime @default(now())
  /// Soft-delete; null = live.
  deletedAt DateTime?

  deposits NeighborhoodDeposit[]

  @@index([deletedAt])
}

/// Singleton shared-edge topology for gap-free SF territory boundaries.
model MapTopology {
  id         String   @id @default("default")
  /// Quantization scale/translate from topojson (optional).
  transform  Json?
  /// Absolute arc coordinates: arcIndex -> [[lng, lat], ...]
  arcs       Json
  /// neighborhoodId -> rings of signed arc indices (topojson-style)
  objects    Json
  /// Arc indices that form shoreline / city outline — not editable.
  lockedArcs Json
  version    Int      @default(1)
  updatedAt  DateTime @updatedAt
}

model NeighborhoodDeposit {
  id             String   @id @default(cuid())
  teamId         String
  neighborhoodId String
  userId         String
  points         Int
  lat            Float
  lng            Float
  accuracy       Float?
  /// Soft-delete; null = counts toward standings/score. Replaces voidedAt.
  deletedAt      DateTime?
  createdAt      DateTime @default(now())

  team         Team         @relation(fields: [teamId], references: [id], onDelete: Cascade)
  neighborhood Neighborhood @relation(fields: [neighborhoodId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([neighborhoodId])
  @@index([teamId])
  @@index([userId])
  @@index([createdAt])
  @@index([deletedAt])
}

/// Client + server telemetry for uploads and playback (lib/telemetry.ts, lib/serverTelemetry.ts).
model ClientEvent {
  id            String   @id @default(cuid())
  createdAt     DateTime @default(now())
  type          String
  /// info | warn | error
  level         String   @default("info")
  /// client | server
  source        String   @default("client")
  userId        String?
  teamId        String?
  submissionId  String?
  challengeId   String?
  sessionId     String?
  attemptId     String?
  durationMs    Int?
  bytes         Int?
  originalBytes Int?
  errorCode     String?
  errorMessage  String?
  platform      String?
  browser       String?
  userAgent     String?
  connection    String?
  sandbox       Boolean  @default(false)
  meta          Json?

  @@index([createdAt])
  @@index([type, createdAt])
  @@index([userId])
  @@index([attemptId])
}

/// Admin upload-testing sandbox runs (pages/admin/upload-testing.tsx).
model UploadTestRun {
  id            String    @id @default(cuid())
  userId        String
  createdAt     DateTime  @default(now())
  deviceLabel   String?
  connection    String?
  fileName      String?
  settings      Json
  metrics       Json
  originalKey   String?
  compressedKey String?
  posterKey     String?
  deletedAt     DateTime?

  @@index([userId])
  @@index([createdAt])
  @@index([deletedAt])
}

/// Admin-authored player announcements (blocking until dismissed).
model Announcement {
  id          String    @id @default(cuid())
  title       String
  /// Markdown body.
  body        String
  /// null = draft (not shown to players). Set when published.
  publishedAt DateTime?
  /// Manual pin: blue banner + top of feed announcements list.
  pinned      Boolean   @default(false)
  /// Blocking “Got it” popup when players open the app (until dismissed).
  forceShow   Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  /// Soft-delete; null = live.
  deletedAt   DateTime?

  createdById String?

  dismissals AnnouncementDismissal[]

  @@index([publishedAt])
  @@index([deletedAt])
  @@index([pinned])
  @@index([forceShow])
}

model AnnouncementDismissal {
  id             String   @id @default(cuid())
  announcementId String
  userId         String
  dismissedAt    DateTime @default(now())

  announcement Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([announcementId, userId])
  @@index([userId])
  @@index([announcementId])
}
